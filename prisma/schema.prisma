  fileUrl    String
  uploadedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ResourceAllocation {
  id                String       @id @default(uuid())
  businessId        String
  projectId         String
  taskId            String?
  employeeId        String
  department        String?
  role              String?
  startDate         DateTime?
  endDate           DateTime?
  estimatedHours    Float        @default(0)
  allocationPercent Float        @default(100)
  priority          String?
  notes             String?
  status            String       @default("Active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee          User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task              ProjectTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaxRule {
  id              String              @id @default(uuid())
  businessId      String
  name            String
  rate            Float
  type            String
  jurisdiction    String?
  isRecoverable   Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  autoProvisioned Boolean             @default(false)
  taxCategory                       String?
  countryCode                       String?
  regionCode                        String?
  placeOfSupply                     String?
  supplyCategory                    String?
  priority                          Int                 @default(0)
  counterpartyTaxRegistrationStatus String?
  rates                             TaxRate[]
  mappings                          TaxAccountMapping[]
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("tax_rules")
}

model TaxAccountMapping {
  id         String   @id @default(uuid())
  businessId String
  taxRuleId  String
  accountId  String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taxRule    TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@unique([taxRuleId, type])
  @@index([businessId])
  @@index([accountId])
  @@map("tax_account_mappings")
}

model Country {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  businesses        Business[]
  exchangeRateRules ExchangeRateRule[]

  @@map("countries")
}

model Currency {
  id                     String             @id @default(uuid())
  code                   String             @unique
  name                   String
  symbol                 String
  decimals               Int                @default(2)
  decimalPrecision       Int                @default(2)
  billsBase              Bill[]             @relation("BillBaseCurrency")
  billsTransaction       Bill[]             @relation("BillTransactionCurrency")
  creditNotesBase        CreditNote[]       @relation("CreditNoteBaseCurrency")
  creditNotesTransaction CreditNote[]       @relation("CreditNoteTransactionCurrency")
  purchaseOrdersBase     PurchaseOrder[]    @relation("PurchaseOrderBaseCurrency")
  purchaseOrdersTxn      PurchaseOrder[]    @relation("PurchaseOrderTransactionCurrency")
  quotationsBase         Quotation[]        @relation("QuotationBaseCurrency")
  quotationsTransaction  Quotation[]        @relation("QuotationTransactionCurrency")
  salesOrdersBase        SalesOrder[]       @relation("SalesOrderBaseCurrency")
  salesOrdersTransaction SalesOrder[]       @relation("SalesOrderTransactionCurrency")
  taxTransactions        TaxTransaction[]   @relation("TaxTransactionCurrency")
  businessesBase         Business[]         @relation("BusinessBaseCurrency")
  exchangeRateRules      ExchangeRateRule[]
  ratesFrom              ExchangeRate[]     @relation("FromExchangeRates")
  ratesTo                ExchangeRate[]     @relation("ToExchangeRates")
  invoicesBase           Invoice[]          @relation("InvoiceBaseCurrency")
  invoicesTransaction    Invoice[]          @relation("InvoiceTransactionCurrency")
  paymentsBase           Payment[]          @relation("PaymentBaseCurrency")
  paymentsTransaction    Payment[]          @relation("PaymentTransactionCurrency")
  purchaseRequestsBase   PurchaseRequest[]  @relation("PurchaseRequestBaseCurrency")
  purchaseRequestsTxn    PurchaseRequest[]  @relation("PurchaseRequestTransactionCurrency")
  purchaseReturnsBase    PurchaseReturn[]   @relation("PurchaseReturnBaseCurrency")
  purchaseReturnsTxn     PurchaseReturn[]   @relation("PurchaseReturnTransactionCurrency")

  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  fromCurrencyId String
  toCurrencyId   String
  rate           Float
  effectiveDate  DateTime
  source         String?
  rateType       String   @default("COMMERCIAL")
  createdAt      DateTime @default(now())
  createdBy      String?
  fromCurrency   Currency @relation("FromExchangeRates", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ToExchangeRates", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId, effectiveDate, rateType])
  @@index([fromCurrencyId, toCurrencyId, rateType, effectiveDate])
  @@map("exchange_rates")
}

model TaxFramework {
  id         String     @id @default(uuid())
  countryId  String     @unique
  name       String
  taxTypes   TaxType[]
  businesses Business[]
}

model TaxType {
  id             String       @id @default(uuid())
  taxFrameworkId String
  name           String
  rates          TaxRate[]
  taxFramework   TaxFramework @relation(fields: [taxFrameworkId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id            String    @id @default(uuid())
  taxTypeId     String
  name          String
  rate          Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  taxRuleId     String?
  taxRule       TaxRule?  @relation(fields: [taxRuleId], references: [id])
  taxType       TaxType   @relation(fields: [taxTypeId], references: [id], onDelete: Cascade)
}

model TaxTransaction {
  id                    String    @id @default(uuid())
  businessId            String
  transactionType       String
  transactionId         String
  taxRateId             String?
  taxAmountTxnCcy       Float
  taxAmountBaseCcy      Float
  taxableAmountBaseCcy  Float     @default(0)
  taxAmountStatutoryCcy Float?
  transactionCurrencyId String?
  itemReference         String?
  overrideRate          Float?
  overrideReason        String?
  overrideTaxTypeId     String?
  isManualOverride      Boolean   @default(false)
  overriddenBy          String?
  overriddenAt          DateTime?
  createdAt             DateTime  @default(now())
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactionCurrency   Currency? @relation("TaxTransactionCurrency", fields: [transactionCurrencyId], references: [id])

  @@index([businessId])
  @@index([transactionType, transactionId])
  @@index([taxRateId])
  @@index([businessId, createdAt])
}

model ExchangeRateRule {
  id                    String   @id @default(uuid())
  countryId             String
  baseCurrencyId        String
  requiresStatutoryRate Boolean  @default(false)
  statutoryRateSource   String?
  baseCurrency          Currency @relation(fields: [baseCurrencyId], references: [id], onDelete: Cascade)
  country               Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, baseCurrencyId])
  @@map("exchange_rate_rules")
}

model DeliveryNote {
  id              String   @id @default(uuid())
  businessId      String
  customerId      String
  salesOrderId    String?
  deliveryNumber  String
  status          String   @default("DRAFT")
  date            DateTime @default(now())
  taxPointTrigger String   @default("INVOICE")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryNoteItem {
  id             String  @id @default(uuid())
  deliveryNoteId String
  productId      String?
  warehouseId    String?
  itemName       String?
  quantity       Float
  unit           String?
}

model DebitNote {
  id                    String   @id @default(uuid())
  businessId            String
  vendorId              String
  billId                String?
  purchaseReturnId      String?
  debitNumber           String
  amount                Float
  remainingAmount       Float
  reason                String?
  status                String   @default("OPEN")
  date                  DateTime @default(now())
  currency              String   @default("AED")
  transactionCurrencyId String?
  baseCurrencyId        String?
  exchangeRate          Float    @default(1.0)
  baseCurrencyAmount    Float    @default(0.0)
  statutoryExchangeRate Float    @default(1.0)
  statutoryBaseAmount   Float    @default(0.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DebitNoteItem {
  id          String  @id @default(uuid())
  debitNoteId String
  productId   String?
  itemName    String?
  description String?
  quantity    Float
  rate        Float
  itemType    String? @default("GOODS")
  unit        String?
  taxPercent  Float?
}

model CustomerToLead {
  A         String
  B         String
  customers Customer @relation(fields: [A], references: [id], onDelete: Cascade)
  Lead      Lead     @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_CustomerToLead_AB_pkey")
  @@index([B], map: "_CustomerToLead_B_index")
  @@map("_CustomerToLead")
}

