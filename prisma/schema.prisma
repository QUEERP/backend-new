generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(uuid())
  name                   String
  email                  String                 @unique
  password               String
  createdAt              DateTime               @default(now())
  isActive               Boolean                @default(true)
  role                   UserRole               @default(USER)
  updatedAt              DateTime               @updatedAt
  activeBusinessId       String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  employees              Employee?
  financeExpenses        Expense[]              @relation("ExpenseFinance")
  managedExpenses        Expense[]              @relation("ExpenseManager")
  projectManagerOf       Project[]              @relation("ProjectManager")
  projectBudgets         ProjectBudget[]
  budgetApprovals        ProjectBudgetHistory[] @relation("BudgetHistoryApprover")
  changeRequestsAssigned ProjectChangeRequest[] @relation("ChangeRequestAssignee")
  changeRequests         ProjectChangeRequest[] @relation("ChangeRequestOwner")
  documentsUploaded      ProjectDocument[]      @relation("DocumentUploader")
  issuesAssigned         ProjectIssue[]         @relation("IssueAssignee")
  issuesReported         ProjectIssue[]         @relation("IssueReporter")
  milestonesOwned        ProjectMilestone[]     @relation("MilestoneOwner")
  assignedReqs           ProjectRequirement[]   @relation("RequirementAssignedTo")
  assignedTasks          ProjectTask[]          @relation("TaskAssignedTo")
  resourceAllocations    ResourceAllocation[]
  ticketComments         TicketComment[]
  memberships            BusinessUser[]
  businessesOwned        Business[]             @relation("BusinessOwner")
  activeBusiness         Business?              @relation("ActiveBusiness", fields: [activeBusinessId], references: [id])
  settings               Settings[]             @relation("SettingsToUser")

  @@map("users")
}

model Business {
  id                     String                 @id @default(uuid())
  name                   String
  ownerId                String
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  businessType           String?
  city                   String?
  country                LegacyCountry          @default(INDIA)
  currency               String?
  description            String?
  emirate                String?
  financialYearEnd       DateTime?
  financialYearStart     DateTime?
  gstNumber              String?
  gstRegistrationType    String?
  industry               String?
  language               String?
  legalName              String?
  msmeNumber             String?
  pan                    String?
  pinCode                String?
  state                  String?
  tan                    String?
  timeZone               String?
  vatNumber              String?
  vatRegistrationDate    DateTime?
  vatRegistrationType    String?
  countryCode            String?
  currencyCode           String?
  currencySymbol         String?
  taxType                String?
  baseCurrencyId         String?
  countryId              String?
  taxFrameworkId         String?
  amcs                   AMC[]
  amcRenewals            AMCRenewal[]
  amcVisits              AMCVisit[]
  accounts               Account[]
  activities             Activity[]
  bills                  Bill[]
  Campaign               Campaign[]
  contracts              Contract[]
  contractTypes          ContractType[]
  creditNotes            CreditNote[]
  CrmTask                CrmTask[]
  customerContacts       CustomerContact[]
  deals                  Deal[]
  documentAuditLogs      DocumentAuditLog[]
  EmailLog               EmailLog[]
  employees              Employee[]
  expenses               Expense[]
  expenseAuditLogs       ExpenseAuditLog[]
  invoiceAuditLogs       InvoiceAuditLog[]
  journalEntries         JournalEntry[]
  leads                  Lead[]
  LeadConversionLog      LeadConversionLog[]
  Note                   Note[]
  overtimes              Overtime[]
  products               Product[]
  projects               Project[]
  projectBudgets         ProjectBudget[]
  projectBudgetHistories ProjectBudgetHistory[]
  projectChangeRequests  ProjectChangeRequest[]
  projectDocuments       ProjectDocument[]
  projectEstimations     ProjectEstimation[]
  projectIssues          ProjectIssue[]
  projectMasters         ProjectMaster[]
  projectMeetings        ProjectMeeting[]
  projectMilestones      ProjectMilestone[]
  projectPlannings       ProjectPlanning[]
  projectRequirements    ProjectRequirement[]
  projectRisks           ProjectRisk[]
  projectTasks           ProjectTask[]
  projectTemplates       ProjectTemplate[]
  purchaseOrders         PurchaseOrder[]
  quotations             Quotation[]
  resourceAllocations    ResourceAllocation[]
  salesOrders            SalesOrder[]
  settings               Settings?
  taxTransactions        TaxTransaction[]
  tickets                Ticket[]
  ticketAttachments      TicketAttachment[]
  ticketComments         TicketComment[]
  timeEntries            TimeEntry[]
  vendors                Vendor[]
  warehouses             Warehouse[]
  warranties             Warranty[]
  warrantyAttachments    WarrantyAttachment[]
  warrantyReminders      WarrantyReminder[]
  attendances            Attendance[]
  auditLogs              AuditLog[]
  batches                Batch[]
  brands                 Brand[]
  users                  BusinessUser[]
  baseCurrency           Currency?              @relation("BusinessBaseCurrency", fields: [baseCurrencyId], references: [id])
  countryRef             Country?               @relation(fields: [countryId], references: [id])
  owner                  User                   @relation("BusinessOwner", fields: [ownerId], references: [id])
  taxFramework           TaxFramework?          @relation(fields: [taxFrameworkId], references: [id])
  categories             Category[]
  complianceTasks        ComplianceTask[]
  customers              Customer[]
  goodsReceiveNotes      GoodsReceiveNote[]
  inventoryLayers        InventoryLayer[]
  invoices               Invoice[]
  notifications          Notification[]
  payments               Payment[]
  purchaseRequests       PurchaseRequest[]
  purchaseReturns        PurchaseReturn[]
  recurringInvoices      RecurringInvoice[]
  roles                  Role[]
  salesReturns           SalesReturn[]
  serialNumbers          SerialNumber[]
  stockAdjustments       StockAdjustment[]
  stockMovements         StockMovement[]
  stockTransfers         StockTransfer[]
  subscription           Subscription?
  taxAccountMappings     TaxAccountMapping[]
  taxRules               TaxRule[]
  units                  Unit[]
  activeUsers            User[]                 @relation("ActiveBusiness")

  @@map("businesses")
}

model BusinessUser {
  id                 String              @id @default(uuid())
  userId             String
  businessId         String
  roleId             String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  activities         Activity[]
  crmTasksAssigned   CrmTask[]           @relation("CrmTaskAssignedTo")
  crmTasksCreated    CrmTask[]           @relation("CrmTaskCreatedBy")
  contactOwner       CustomerContact[]   @relation("ContactOwner")
  deals              Deal[]
  leads              Lead[]
  leadConversionLogs LeadConversionLog[]
  createdNotes       Note[]              @relation("NoteCreatedBy")
  purchaseOrders     PurchaseOrder[]
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  timeEntries        TimeEntry[]
  business           Business            @relation(fields: [businessId], references: [id])
  role               Role                @relation(fields: [roleId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  customerOwner      Customer[]          @relation("CustomerOwner")
  purchaseRequests   PurchaseRequest[]
  userPermissions    UserPermission[]

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_users")
}

model Role {
  id              String           @id @default(uuid())
  name            String
  businessId      String
  createdAt       DateTime         @default(now())
  users           BusinessUser[]
  rolePermissions RolePermission[]
  business        Business         @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  action          String
  moduleId        String
  module          Module           @relation(fields: [moduleId], references: [id])
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([moduleId, action])
  @@map("permissions")
}

model Module {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[]

  @@map("modules")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id             String       @id @default(uuid())
  businessUserId String
  permissionId   String
  businessUser   BusinessUser @relation(fields: [businessUserId], references: [id])
  permission     Permission   @relation(fields: [permissionId], references: [id])

  @@unique([businessUserId, permissionId])
  @@map("user_permissions")
}

/// ///////////////////////////////////////////////////
/// ///////////////////////////////////////////////////
model Customer {
  id                  String               @id @default(uuid())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  businessId          String
  phone               String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  address             String?
  createdAt           DateTime             @default(now())
  billingCity         String?
  billingCountry      String?
  billingState        String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  billingStreet       String?
  billingZipCode      String?
  city                String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  company             String
  country             String?
  currency            String               @default("SYSTEM")
  defaultLanguage     String               @default("SYSTEM")
  group               String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  isActive            Boolean              @default(true)
  shippingCity        String?
  shippingCountry     String?
  shippingState       String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  shippingStreet      String?
  shippingZipCode     String?
  state               String?
  updatedAt           DateTime             @updatedAt
  vatNumber           String?
  website             String?
  zipCode             String?
  leadId              String?              @unique
  region              Region
  accountOwnerId      String?
  accountType         CrmAccountType?
  annualRevenue       Float?
  crmStatus           CrmStatus?
  deletedAt           DateTime?
  description         String?
  employeeCount       Int?
  facebookUrl         String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  industry            String?
  isDeleted           Boolean              @default(false)
  lastContactedAt     DateTime?
  linkedinUrl         String?
  parentAccountId     String?
  tags                String[]
  twitterUrl          String?
  amcs                AMC[]
  activities          Activity[]
  contracts           Contract[]
  creditNotes         CreditNote[]
  crmTasks            CrmTask[]
  customerContacts    CustomerContact[]
  deals               Deal[]
  emailLogs           EmailLog[]
  expenses            Expense[]
  inquiries           Lead[]               @relation("LeadToCustomer")
  leadConversionLogs  LeadConversionLog[]
  notes               Note[]
  projects            Project[]
  projectBudgets      ProjectBudget[]
  projectMeetings     ProjectMeeting[]
  projectRequirements ProjectRequirement[]
  quotations          Quotation[]
  salesOrders         SalesOrder[]
  tickets             Ticket[]
  warranties          Warranty[]
  CustomerToLead      CustomerToLead[]
  accountOwner        BusinessUser?        @relation("CustomerOwner", fields: [accountOwnerId], references: [id])
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentAccount       Customer?            @relation("CustomerParentChild", fields: [parentAccountId], references: [id])
  childAccounts       Customer[]           @relation("CustomerParentChild")
  invoices            Invoice[]
  payments            Payment[]
  recurringInvoices   RecurringInvoice[]
  salesReturns        SalesReturn[]

  @@index([businessId])
  @@index([accountOwnerId])
  @@index([parentAccountId])
  @@index([isDeleted])
  @@map("customers")
}

model Invoice {
  id                    String              @id @default(uuid())
  businessId            String
  customerId            String
  invoiceNumber         String
  status                InvoiceStatus       @default(UNPAID)
  dueDate               DateTime?
  createdAt             DateTime            @default(now())
  adminNote             String?
  currency              String              @default("AED")
  discount              Float               @default(0)
  grandTotal            Float               @default(0)
  invoiceDate           DateTime            @default(now())
  poDate                DateTime?
  poNumber              String?
  subtotal              Float               @default(0)
  terms                 String?
  totalTax              Float               @default(0)
  updatedAt             DateTime            @updatedAt
  pdfUrl                String?
  salesOrderId          String?
  projectId             String?
  cgst                  Float?              @default(0)
  contactId             String?
  deletedAt             DateTime?
  designTemplate        String              @default("modern")
  emirate               String?
  ewayBillNo            String?
  igst                  Float?              @default(0)
  isDeleted             Boolean             @default(false)
  quotationId           String?
  reverseCharge         Boolean?            @default(false)
  sgst                  Float?              @default(0)
  shippingCharges       Float               @default(0)
  soDate                DateTime?
  soNumber              String?
  tds                   Float?              @default(0)
  totalCogs             Float?              @default(0)
  totalGrossProfit      Float?              @default(0)
  transportDetails      String?
  vatAmount             Float?              @default(0)
  vatPercentage         Float?              @default(0)
  vatType               String?
  amountPaid            Float               @default(0)
  exchangeRate          Float?
  baseCurrencyAmount    Float?
  baseCurrencyId        String?
  isLegacyUntracked     Boolean             @default(false)
  statutoryBaseAmount   Float?
  statutoryExchangeRate Float?
  transactionCurrencyId String?
  creditNotes           CreditNote[]
  auditLogs             InvoiceAuditLog[]
  items                 InvoiceItem[]
  baseCurrency          Currency?           @relation("InvoiceBaseCurrency", fields: [baseCurrencyId], references: [id])
  business              Business            @relation(fields: [businessId], references: [id])
  contact               CustomerContact?    @relation(fields: [contactId], references: [id])
  customer              Customer            @relation(fields: [customerId], references: [id])
  project               Project?            @relation(fields: [projectId], references: [id])
  quotation             Quotation?          @relation(fields: [quotationId], references: [id])
  salesOrder            SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  transactionCurrency   Currency?           @relation("InvoiceTransactionCurrency", fields: [transactionCurrencyId], references: [id])
  paymentAllocations    PaymentAllocation[]
  payments              Payment[]
  salesReturns          SalesReturn[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, invoiceDate])
  @@index([businessId, status])
  @@index([businessId, transactionCurrencyId])
  @@map("invoices")
}

model InvoiceAuditLog {
  id          String   @id @default(uuid())
  businessId  String
  invoiceId   String
  action      String
  performedBy String?
  comments    String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceItem {
  id                  String     @id @default(uuid())
  invoiceId           String
  description         String
  amount              Float
  createdAt           DateTime   @default(now())
  hours               Float
  rate                Float
  taxDetails          Json?
  totalAmount         Float      @default(0)
  totalTax            Float      @default(0)
  cgstPercent         Float?     @default(0)
  cogsAmount          Float?     @default(0)
  discount            Float      @default(0)
  grossMarginPercent  Float?     @default(0)
  grossProfit         Float?     @default(0)
  hsnSacCode          String?
  igstPercent         Float?     @default(0)
  itemType            String?
  productId           String?
  quantity            Float      @default(1)
  sgstPercent         Float?     @default(0)
  taxPercent          Float?     @default(0)
  unit                String?
  unitCost            Float?     @default(0)
  valuationMethodUsed String?
  warehouseId         String?
  itemName            String?
  invoice             Invoice    @relation(fields: [invoiceId], references: [id])
  product             Product?   @relation(fields: [productId], references: [id])
  warehouse           Warehouse? @relation(fields: [warehouseId], references: [id])

  @@map("invoice_items")
}

model Subscription {
  id         String             @id @default(uuid())
  businessId String             @unique
  status     SubscriptionStatus @default(INACTIVE)
  startDate  DateTime?
  expiresAt  DateTime?
  planName   String?
  notes      String?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id])

  @@map("subscriptions")
}

/// ///////////////////////////////////////////////////
/// ///////////////////////////////////////////////////
model Settings {
  id                  Int      @id @default(autoincrement())
  businessId          String   @unique
  companyName         String
  address             String?
  phone               String?
  email               String?
  website             String?
  trn                 String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  accountName         String?
  accountNumber       String?
  bankAddress         String?
  bankName            String?
  companyLogo         String?
  iban                String?
  swiftCode           String?
  defaultFooterNote   String?
  defaultTerms        String?
  invoiceFormat       String   @default("INV-YYYY-MM-DD-COUNT")
  signatureUrl        String?
  leaveTypes          Json?
  overtimeThreshold   Float    @default(2)
  currency            String   @default("INR")
  currencySymbol      String   @default("₹")
  invoiceTemplate     String   @default("modern")
  valuationMethod     String   @default("FIFO")
  barcodeTracking     Boolean  @default(false)
  batchTracking       Boolean  @default(false)
  creditNotePrefix    String?
  defaultTaxSettings  Json?
  defaultWarehouseId  String?
  digitalSignature    String?
  exportSettings      Json?
  fiscalYear          String?
  ifsc                String?
  importSettings      Json?
  invoicePrefix       String?
  negativeStock       Boolean  @default(false)
  paymentPrefix       String?
  placeOfSupply       String?
  purchaseOrderPrefix String?
  quotationPrefix     String?
  reverseCharge       Boolean  @default(false)
  salesOrderPrefix    String?
  serialTracking      Boolean  @default(false)
  busniess            Business @relation(fields: [businessId], references: [id])
  users               User[]   @relation("SettingsToUser")
}

model Payment {
  id                    String              @id @default(uuid())
  invoiceId             String?
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  businessId            String
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  amount                Float
  paymentDate           DateTime
  paymentMode           String
  transactionId         String?
  note                  String?
  createdAt             DateTime            @default(now())
  /// ///////////////////////////////////////////////////
  /// ///////////////////////////////////////////////////
  createdBy             String
  pdfUrl                String?
  paymentNumber         String
  billId                String?
  customerId            String?
  quotationId           String?
  amountAllocated       Float               @default(0)
  projectId             String?
  status                String              @default("unapplied")
  currency              String?             @default("AED")
  exchangeRate          Float?
  baseCurrencyAmount    Float?
  baseCurrencyId        String?
  isLegacyUntracked     Boolean             @default(false)
  statutoryBaseAmount   Float?
  statutoryExchangeRate Float?
  transactionCurrencyId String?
  paymentAllocations    PaymentAllocation[]
  baseCurrency          Currency?           @relation("PaymentBaseCurrency", fields: [baseCurrencyId], references: [id])
  bill                  Bill?               @relation(fields: [billId], references: [id])
  business              Business            @relation(fields: [businessId], references: [id])
  customer              Customer?           @relation(fields: [customerId], references: [id])
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id])
  project               Project?            @relation(fields: [projectId], references: [id])
  quotation             Quotation?          @relation(fields: [quotationId], references: [id])
  transactionCurrency   Currency?           @relation("PaymentTransactionCurrency", fields: [transactionCurrencyId], references: [id])

  @@index([businessId, paymentDate, transactionCurrencyId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([businessId, paymentDate])
  @@index([businessId, transactionCurrencyId])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  invoiceId       String
  allocatedAmount Float
  allocationType  String
  createdBy       String
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  payment         Payment  @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model CreditNote {
  id                    String           @id @default(uuid())
  /// /////////////////////////////////////////////////
  /// /////////////////////////////////////////////////
  businessId            String
  customerId            String?
  invoiceId             String?
  /// /////////////////////////////////////////////////
  /// /////////////////////////////////////////////////
  creditNumber          String
  amount                Float
  remainingAmount       Float
  reason                String?
  status                CreditNoteStatus @default(OPEN)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  pdfUrl                String?
  type                  CreditNoteType
  vendorId              String?
  deletedAt             DateTime?
  isDeleted             Boolean          @default(false)
  salesReturnId         String?
  currency              String?          @default("AED")
  exchangeRate          Float?
  baseCurrencyAmount    Float?
  baseCurrencyId        String?
  isLegacyUntracked     Boolean          @default(false)
  statutoryBaseAmount   Float?
  statutoryExchangeRate Float?
  transactionCurrencyId String?
  baseCurrency          Currency?        @relation("CreditNoteBaseCurrency", fields: [baseCurrencyId], references: [id])
  business              Business         @relation(fields: [businessId], references: [id])
  customer              Customer?        @relation(fields: [customerId], references: [id])
  invoice               Invoice?         @relation(fields: [invoiceId], references: [id])
  salesReturn           SalesReturn?     @relation(fields: [salesReturnId], references: [id])
  transactionCurrency   Currency?        @relation("CreditNoteTransactionCurrency", fields: [transactionCurrencyId], references: [id])
  vendor                Vendor?          @relation(fields: [vendorId], references: [id])

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, transactionCurrencyId])
  @@index([businessId, createdAt])
}

model Employee {
  id                 String              @id @default(uuid())
  businessId         String
  name               String
  email              String?
  phone              String?
  designation        String?
  joinDate           DateTime?
  basicSalary        Float
  createdAt          DateTime            @default(now())
  allowance          Json?
  deduction          Json?
  leaveBalance       Json?
  userId             String?             @unique
  accountHolderName  String?
  accountNumber      String?
  bankName           String?
  Code               String?
  amcsAssigned       AMC[]               @relation("AMCEngineer")
  amcVisits          AMCVisit[]
  bankChangeRequests BankChangeRequest[]
  business           Business            @relation(fields: [businessId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  expenses           Expense[]
  leaves             Leave[]
  loans              Loan[]
  overtimes          Overtime[]
  payslips           Payslip[]
  ticketsAssigned    Ticket[]            @relation("TicketEngineer")
  timeEntries        TimeEntry[]
  attendances        Attendance[]
}

model Attendance {
  id         String    @id @default(uuid())
  businessId String
  employeeId String
  date       DateTime
  status     String
  checkIn    DateTime?
  checkOut   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([businessId, employeeId, date])
  @@index([businessId, date])
  @@map("attendances")
}

model Payslip {
  id            String   @id @default(uuid())
  payrollId     String
  employeeId    String
  basicSalary   Float
  allowance     Float    @default(0)
  deduction     Float    @default(0)
  netSalary     Float
  status        String   @default("pending")
  pdfUrl        String?
  createdAt     DateTime @default(now())
  employeeName  String
  overtimePay   Float    @default(0)
  loanDeduction Float    @default(0)
  employee      Employee @relation(fields: [employeeId], references: [id])
  payroll       Payroll  @relation(fields: [payrollId], references: [id])
}

model Payroll {
  id         String    @id @default(uuid())
  businessId String
  month      Int
  year       Int
  status     String    @default("draft")
  createdAt  DateTime  @default(now())
  payslips   Payslip[]
}

model Leave {
  id         String   @id @default(uuid())
  businessId String
  employeeId String
  leaveCode  String
  date       DateTime
  duration   String
  createdAt  DateTime @default(now())
  status     String   @default("PENDING")
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model BankChangeRequest {
  id                String        @id @default(uuid())
  employeeId        String
  businessId        String
  bankName          String
  accountNumber     String
  accountHolderName String
  status            RequestStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  Code              String
  country           String
  employee          Employee      @relation(fields: [employeeId], references: [id])
}

model Overtime {
  id            String   @id @default(uuid())
  employeeId    String
  businessId    String
  overtimeHours Float
  date          DateTime
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([businessId, employeeId])
}

model Loan {
  id              String   @id @default(uuid())
  employeeId      String
  businessId      String
  totalAmount     Float
  remainingAmount Float
  emiAmount       Float
  startDate       DateTime
  status          String   @default("active")
  createdAt       DateTime @default(now())
  employee        Employee @relation(fields: [employeeId], references: [id])
}

model Expense {
  id               String            @id @default(uuid())
  businessId       String
  title            String
  amount           Float
  category         String?
  paymentMethod    String
  date             DateTime
  notes            String?
  vendorId         String?
  createdAt        DateTime          @default(now())
  approvalComments String?
  costCenter       String?
  department       String?
  employeeId       String?
